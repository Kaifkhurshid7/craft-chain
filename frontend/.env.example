# Smart Contract Configuration
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SEPOLIA_CHAIN_ID=11155111

# Alchemy RPC Configuration
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key
NEXT_PUBLIC_ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key

# IPFS Configuration
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Server-only (no NEXT_PUBLIC_ prefix) so the JWT never reaches the browser
PINATA_JWT=your_pinata_jwt_token

# Optional: Application Configuration
NEXT_PUBLIC_APP_NAME=Craft-Chain
NEXT_PUBLIC_APP_DESCRIPTION=Blockchain-Based Craft Batch Traceability System

# Optional: Analytics
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
